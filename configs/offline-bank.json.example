{
  "meta": {
    "version": "0.1",
    "lastTouchedVersion": "2026.3.14",
    "lastTouchedAt": "2026-04-02T07:17:34.169Z"
  },
  "logging": {
    "level": "info"
  },
  "update": {
    "checkOnStart": false,
    "auto": {
      "enabled": false
    }
  },
  "models": {
    "providers": {
      "local-openai": {
        "baseUrl": "http://YOUR_SERVER:8080/v2/coding",
        "apiKey": "YOUR_GLM_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5",
            "name": "glm-5",
            "api": "openai-completions",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 32768,
            "maxTokens": 32768
          }
        ]
      },
      "volces-kimi": {
        "baseUrl": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "apiKey": "YOUR_KIMI_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "kimi-k2.5",
            "name": "Kimi K2.5",
            "api": "openai-completions",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "local-openai/glm-5"
      },
      "models": {
        "local-openai/glm-5": {},
        "volces-kimi/kimi-k2.5": {}
      },
      "sandbox": {
        "mode": "off"
      }
    },
    "list": [
      {
        "id": "default",
        "default": true,
        "name": "Default Agent",
        "model": {
          "primary": "local-openai/glm-5"
        },
        "tools": {
          "allow": [
            "bash",
            "read",
            "write",
            "edit"
          ]
        }
      }
    ]
  },
  "tools": {
    "exec": {
      "security": "allowlist",
      "ask": "on-miss",
      "pathPrepend": [
        "scripts",
        "tools"
      ],
      "safeBins": [
        "python",
        "python3",
        "node",
        "npm",
        "powershell",
        "pwsh",
        "cmd",
        "cmd.exe"
      ]
    },
    "fs": {
      "workspaceOnly": false,
      "allowedDirectories": [
        "C:\\Users\\YOUR_USER\\My Projects\\AIAgentLab\\openclaw_mini",
        "C:\\Users\\YOUR_USER\\Documents",
        "C:\\Users\\YOUR_USER\\Desktop"
      ]
    }
  },
  "media": {
    "preserveFilenames": false
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "controlUi": {
      "menuVisibility": {
        "chat": true,
        "overview": true,
        "usage": true,
        "cron": true,
        "channels": false,
        "agents": true,
        "sessions": false,
        "skills": false,
        "tools": false,
        "models": false,
        "config": true,
        "nodes": true,
        "communications": false,
        "appearance": false,
        "automation": false,
        "infrastructure": false,
        "aiAgents": false,
        "debug": false,
        "logs": true,
        "docs": false,
        "instances": false
      }
    },
    "auth": {
      "mode": "token",
      "token": "YOUR_GATEWAY_TOKEN"
    },
    "audit": {
      "enabled": true,
      "file": "logs/audit.log",
      "level": "detailed",
      "rotateDaily": true
    }
  },
  "plugins": {
    "enabled": true,
    "allow": [
      "memory-core",
      "memory-lancedb"
    ]
  }
}
